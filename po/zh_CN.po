msgstr "登录时启动 Quake 全局快捷键服务"

#: src/org.gnome.Ptyxis.gschema.xml.in:201
msgid "Quake Autostart Prompt Shown"
msgstr "已显示 Quake 自动启动提示"

#: src/org.gnome.Ptyxis.gschema.xml.in:202
msgid ""
"Whether the user has answered the Quake shortcut service autostart prompt"
msgstr "用户是否已回答 Quake 快捷键服务自动启动提示"

#: src/org.gnome.Ptyxis.gschema.xml.in:206
msgid "Current Quake global shortcut description"
msgstr "当前 Quake 全局快捷键描述"

#: src/org.gnome.Ptyxis.gschema.xml.in:207
