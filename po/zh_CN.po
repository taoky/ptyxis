msgstr "复制时裁剪尾随空格"

#: src/org.gnome.Ptyxis.gschema.xml.in:219
msgid "Remove trailing spaces from each line when copying plain text"
msgstr "复制纯文本时移除每行末尾的空格"

#: src/org.gnome.Ptyxis.gschema.xml.in:224 src/ptyxis-preferences-window.ui:357
msgid "Restore Window Size"
msgstr "恢复窗口大小"

#: src/org.gnome.Ptyxis.gschema.xml.in:225
