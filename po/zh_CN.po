msgstr "用户按键时滚动到底部"

#: src/org.gnome.Ptyxis.gschema.xml.in:332 src/ptyxis-profile-editor.ui:187
msgid "Use Custom Command"
msgstr "使用自定义命令"

#: src/org.gnome.Ptyxis.gschema.xml.in:333
